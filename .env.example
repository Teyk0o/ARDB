# Vercel Postgres Database
# Get these from Vercel Dashboard > Storage > Postgres
POSTGRES_URL=
POSTGRES_PRISMA_URL=
POSTGRES_URL_NON_POOLING=
POSTGRES_URL_NO_SSL=
POSTGRES_USER=
POSTGRES_HOST=
POSTGRES_PASSWORD=
POSTGRES_DATABASE=

# Discord OAuth
# Create an application at https://discord.com/developers/applications
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=http://localhost:3000/api/auth/discord/callback

# Discord Bot (for role checking)
# Create a bot in the same Discord application
# Grant it 'Guild Members' intent
DISCORD_BOT_TOKEN=

# Discord Server Configuration
DISCORD_GUILD_ID=1439278522924404744
DISCORD_MODERATOR_ROLE_ID=1443865078779875443

# Discord Webhook (for notifications)
# Create a webhook in your Discord server channel
DISCORD_WEBHOOK_URL=

# JWT Secret (generate a random string)
# You can use: openssl rand -base64 32
JWT_SECRET=

# Next.js Configuration
NEXT_PUBLIC_BASE_URL=http://localhost:3000
NODE_ENV=development
